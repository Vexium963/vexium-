{
  "name": "vexiumverse-bot",
  "version": "1.0.0",
  "description": "The ultimate Discord economy bot with immersive features and advanced trading systems",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "deploy": "node deploy-commands.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "backup": "node scripts/backup.js",
    "migrate": "node scripts/migrate.js",
    "setup": "node scripts/setup.js",
    "docker:build": "docker build -t vexiumverse-bot .",
    "docker:run": "docker run -d --env-file .env --name vexiumverse vexiumverse-bot",
    "postinstall": "npm run setup"
  },
  "keywords": [
    "discord",
    "bot",
    "economy",
    "trading",
    "gaming",
    "cryptocurrency",
    "nft",
    "social",
    "progression",
    "achievements"
  ],
  "author": {
    "name": "VexiumVerse Team",
    "email": "contact@vexiumverse.com",
    "url": "https://vexiumverse.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Vexium963/vexium-/issues"
  },
  "homepage": "https://github.com/Vexium963/vexium-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vexium963/vexium-.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "axios": "^1.6.0",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "@types/node": "^20.10.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2022
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
