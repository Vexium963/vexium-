# ================================
# VexiumVerse Bot Configuration
# ================================

# REQUIRED: Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here

# OPTIONAL: Development Configuration
# Uncomment for guild-specific testing
# GUILD_ID=your_test_server_id_here

# ================================
# Database Configuration
# ================================

# For JSON Database (Default)
# No additional configuration needed

# For PostgreSQL (Production)
# DATABASE_URL=postgresql://username:password@localhost:5432/vexiumverse
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vexiumverse
# DB_USER=your_db_username
# DB_PASS=your_db_password

# For MongoDB (Alternative)
# MONGODB_URI=mongodb://localhost:27017/vexiumverse

# ================================
# Security Configuration
# ================================

# Admin user IDs (comma-separated)
BOT_ADMIN_IDS=your_user_id_here,another_admin_id

# API Keys for external services
COINGECKO_API_KEY=your_coingecko_api_key
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# Encryption keys (generate random strings)
ENCRYPTION_KEY=your_32_character_encryption_key_here
JWT_SECRET=your_jwt_secret_for_sessions_here

# ================================
# Webhook Configuration
# ================================

# Discord webhooks for logging
ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/your_error_webhook
AUDIT_WEBHOOK_URL=https://discord.com/api/webhooks/your_audit_webhook
SECURITY_WEBHOOK_URL=https://discord.com/api/webhooks/your_security_webhook

# ================================
# Feature Toggles
# ================================

# Enable/disable major features
ENABLE_CRYPTO_FEATURES=true
ENABLE_NFT_FEATURES=false
ENABLE_AI_TRADING=false
ENABLE_ANALYTICS=true

# Economy settings
STARTING_BALANCE=1000
MAX_DAILY_REWARD=5000
WORK_COOLDOWN_MINUTES=60
ENTERTAINMENT_DAILY_LIMIT=50000

# ================================
# External Service Configuration
# ================================

# Redis for caching (optional)
# REDIS_URL=redis://localhost:6379

# Sentry for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=your_ga_id
# MIXPANEL_TOKEN=your_mixpanel_token

# ================================
# Development Settings
# ================================

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Environment (development, production)
NODE_ENV=development

# Debug features
DEBUG_MODE=false
ENABLE_DEV_COMMANDS=false

# ================================
# Deployment Settings
# ================================

# Port for health checks
PORT=3000

# Heroku/Railway specific
# (These are set automatically by the platform)
# PORT=
# DATABASE_URL=

# Docker specific
# DOCKER_ENV=true

# ================================
# Backup Configuration
# ================================

# Automatic backup settings
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Cloud storage for backups (optional)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_backup_bucket

# ================================
# Performance Settings
# ================================

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Memory management
MAX_MEMORY_USAGE_MB=512
GARBAGE_COLLECTION_INTERVAL_MS=300000

# ================================
# Social Features
# ================================

# Maximum values for social features
MAX_GIFT_AMOUNT=100000
MAX_TRADE_VALUE=1000000
LEADERBOARD_UPDATE_INTERVAL_MINUTES=15

# ================================
# Maintenance Mode
# ================================

# Set to true to enable maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="VexiumVerse is currently under maintenance. We'll be back soon!"

# Allowed users during maintenance (comma-separated)
MAINTENANCE_ALLOWED_USERS=your_user_id_here
